        <mxCell id="title" value="AgentCell 统一定义、角色用法与内部实现关系视图" style="text;html=1;align=center;verticalAlign=middle;fontFamily=Noto Sans CJK SC;fontSize=28;fontStyle=1;fontColor=#182230;" vertex="1" parent="1"><mxGeometry x="490" y="20" width="920" height="50" as="geometry"/></mxCell>
        <mxCell id="agentCell" value="«part def»&#xa;AgentCell&#xa;𝔄ᵢ = (𝒮ᵢ, 𝒳ᵢ, 𝒴ᵢ, 𝒜ᵢ, φᵢ, Mᵢ, Ψᵢ)&#xa;同一形式 · 可递归组合 · 唯一Owner责任&#xa;roleKind : AgentRoleKind&#xa;subAgents : AgentCell [0..*]&#xa;skills : RobotSkill [0..*]" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F1EDFA;strokeColor=#735FA5;strokeWidth=2;fontFamily=Noto Sans CJK SC;fontSize=15;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="590" y="175" width="720" height="315" as="geometry"/></mxCell>
        <mxCell id="recursivePorts" value="«port group»&#xa;统一递归接口&#xa;观察、共享引用与契约输入&#xa;结果、候选操作与Skill请求&#xa;反馈、干预与下级Agent关系" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EAF3FF;strokeColor=#4F79A8;strokeWidth=2;fontFamily=Noto Sans CJK SC;fontSize=15;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="70" y="225" width="380" height="210" as="geometry"/></mxCell>
        <mxCell id="roleKind" value="«enum def»&#xa;AgentRoleKind&#xa;root · businessDomain · task&#xa;skill · control&#xa;责任分类属性，不构成继承层级" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F3F5F7;strokeColor=#64748B;strokeWidth=2;fontFamily=Noto Sans CJK SC;fontSize=15;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1450" y="225" width="380" height="210" as="geometry"/></mxCell>

        <mxCell id="a0" value="«part usage»&#xa;A0 : AgentCell&#xa;roleKind = root&#xa;根任务与用户承诺Owner&#xa;普通AgentCell用法" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F1EDFA;strokeColor=#735FA5;strokeWidth=2;fontFamily=Noto Sans CJK SC;fontSize=15;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="45" y="585" width="330" height="180" as="geometry"/></mxCell>
        <mxCell id="businessAgents" value="«part usage»&#xa;businessAgents[4] : AgentCell&#xa;roleKind = businessDomain&#xa;长期基础业务责任Owner" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F1EDFA;strokeColor=#735FA5;strokeWidth=2;fontFamily=Noto Sans CJK SC;fontSize=15;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="415" y="585" width="330" height="180" as="geometry"/></mxCell>
        <mxCell id="taskWorker" value="«part def»&#xa;TaskWorker&#xa;specializes AgentCell&#xa;roleKind = task&#xa;一次有界任务契约Owner&#xa;完成／失败／取消／回收约束" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EEEAF8;strokeColor=#735FA5;strokeWidth=2;fontFamily=Noto Sans CJK SC;fontSize=15;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="785" y="570" width="330" height="210" as="geometry"/></mxCell>
